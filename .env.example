# GEMINI_API_KEY: Server-side only. Used by Firebase Cloud Functions.
# This key is NOT bundled into the client app.
GEMINI_API_KEY=your_gemini_api_key_here

# API Base URL: Points to your deployed Firebase Cloud Functions.
# Leave empty for local development. In production, set to your Cloud Functions URL.
VITE_API_BASE_URL=

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
